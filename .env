APP_NAME="Hotel PMS"
APP_ENV=local
APP_KEY=base64:hcPXjdp8U7AeeqZwZVHOEQV7wWDM5x64dpUfjJlWYP8=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default: SQLite (zero-config). To use MySQL instead, set DB_CONNECTION=mysql
# and fill in DB_HOST / DB_DATABASE / DB_USERNAME / DB_PASSWORD below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_pms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
